POSTGRES_DB=foodmind
POSTGRES_USER=foodmind
POSTGRES_PASSWORD=foodmind_local_password
POSTGRES_PORT=5432

SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/foodmind
DB_USERNAME=foodmind
DB_PASSWORD=foodmind_local_password
WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_ISSUER=foodmind-local
JWT_AUDIENCE=foodmind-clients
JWT_PUBLIC_KEY=local-development-placeholder
DELEGATION_JWT_AUDIENCE=foodmind-agent-tools
DELEGATION_JWT_TOKEN_TTL=2m
INTERNAL_SERVICE_TOKEN=local-development-service-token

AGENT_SERVICE_BASE_URL=http://localhost:8001
AGENT_SERVICE_TOKEN=local-development-token
COOKING_AGENT_ENABLED=true
COOKING_AGENT_BASE_URL=http://localhost:8003
COOKING_AGENT_SERVICE_TOKEN=local-development-token
COOKING_TASK_POLL_ENABLED=true
INFERENCE_SERVICE_BASE_URL=http://localhost:8002
INFERENCE_SERVICE_TOKEN=local-development-token
RECOMMENDATION_AGENT_ENABLED=true
RECOMMENDATION_AGENT_BASE_URL=http://localhost:8001
RECOMMENDATION_AGENT_ENDPOINT_PATH=/internal/v1/recommendations/generate
RECOMMENDATION_AGENT_SERVICE_TOKEN=local-recommendation-token
RECOMMENDATION_AGENT_READ_TIMEOUT=65s
COOKING_AGENT_ENABLED=true
COOKING_AGENT_BASE_URL=http://localhost:8003
COOKING_AGENT_SERVICE_TOKEN=local-cooking-token
COOKING_AGENT_READ_TIMEOUT=5m
COOKING_AGENT_REGION=SG
CHAT_AGENT_ENABLED=true
CHAT_AGENT_BASE_URL=http://localhost:8004
CHAT_AGENT_SERVICE_TOKEN=local-chat-token
CHAT_AGENT_READ_TIMEOUT=65s

# Enable only after the local MinIO bucket has been created. Do not commit real cloud credentials.
MEDIA_ENABLED=false
MEDIA_S3_BUCKET=foodmind-media
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_ACCESS_KEY=minioadmin
MEDIA_S3_SECRET_KEY=local-minio-password-change-me
MEDIA_S3_KEY_PREFIX=media
MEDIA_UPLOAD_TTL=5m
MEDIA_MAX_BYTE_SIZE=5242880
